# Client-safe feature flags. Never place provider secrets in VITE_* variables.
VITE_ENABLE_DEEPGRAM=false
VITE_ENABLE_WHISPER=false
VITE_ENABLE_GRADIUM=false

# Existing application configuration (optional for demo mode).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_GOOGLE_CLIENT_ID=

# Configure these only in the server/worker environment used by
# /api/voice/transcribe and /api/voice/rate. Do not expose them to the browser.
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
GRADIUM_API_KEY=

# AI providers for /api/career-research, /api/career-coach and /api/career-brief.
# Never expose these as VITE_ variables. Providers are tried in order and the
# first configured, working one is used — so a rate-limited free tier falls
# through to the next instead of failing the feature.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
COHERE_API_KEY=
COHERE_MODEL=command-a-03-2025
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# OPTIONAL paid web search. Research works without it: by default it discovers
# sources for free via Wikipedia/Wikidata (official site) and the site's own
# sitemap + conventional paths, then reads them with the polite crawler.
# Leave this empty unless you specifically want Brave's wider web results.
BRAVE_SEARCH_API_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Exact hostnames whose retrieval/processing terms you have reviewed.
# Discovered sources outside this list stay links, not scraped evidence.
RESEARCH_ALLOWED_HOSTS=
# Hosts the polite crawler may fetch. Use '*' to allow any discovered host
# (each host is still robots.txt-checked, rate-limited and size-capped).
# Leaving this empty means no crawling beyond RESEARCH_ALLOWED_HOSTS.
RESEARCH_CRAWL_HOSTS=
# Respect robots.txt. Set to 'false' only for hosts you own or have written
# permission to crawl aggressively. Default: true.
RESEARCH_RESPECT_ROBOTS=true
# Total pages fetched per research run across all hosts. Default: 12.
RESEARCH_CRAWL_BUDGET=12
# Maximum pages fetched from a single host per run. Default: 5.
RESEARCH_MAX_PAGES_PER_HOST=5
# Minimum delay in milliseconds between requests to the same host. Default: 1500.
RESEARCH_MIN_DELAY_MS=1500
