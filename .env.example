# Client-safe feature flags. Never place provider secrets in VITE_* variables.
VITE_ENABLE_DEEPGRAM=false
VITE_ENABLE_WHISPER=false
VITE_ENABLE_GRADIUM=false

# Existing application configuration (optional for demo mode).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_GOOGLE_CLIENT_ID=

# Configure these only in the server/worker environment used by
# /api/voice/transcribe and /api/voice/rate. Do not expose them to the browser.
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
GRADIUM_API_KEY=

# Optional server-side key for /api/career-research and /api/career-coach.
# Never expose this as a VITE_ variable.
GEMINI_API_KEY=
# Career workspace research (server-only). Configure a currently supported model.
GEMINI_MODEL=
BRAVE_SEARCH_API_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Exact hostnames whose retrieval/processing terms you have reviewed.
# Discovered sources outside this list stay links, not scraped evidence.
RESEARCH_ALLOWED_HOSTS=
